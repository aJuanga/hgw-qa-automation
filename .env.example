# Copiar como .env y completar. NUNCA subir el archivo .env a GitHub.
HGW_BASE_URL=http://localhost:8000

# Usuarios de prueba del sistema HGW (creados por los seeders)
HGW_JEFA_EMAIL=jefa@healthyglow.com
HGW_JEFA_PASSWORD=
HGW_EMPLEADO_EMAIL=empleado1@healthyglow.com
HGW_EMPLEADO_PASSWORD=
HGW_CLIENTE_EMAIL=pedro@gmail.com
HGW_CLIENTE_PASSWORD=

# Envío de resultados por correo (Gmail: usar contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_TO=

# Inteligencia Artificial (opcional). Sin clave se usa el analizador por reglas.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
