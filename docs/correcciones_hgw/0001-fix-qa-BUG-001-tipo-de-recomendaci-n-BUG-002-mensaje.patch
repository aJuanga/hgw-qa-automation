diff --git a/app/Http/Controllers/ProductController.php b/app/Http/Controllers/ProductController.php
index 1e3e981..f91c2da 100644
--- a/app/Http/Controllers/ProductController.php
+++ b/app/Http/Controllers/ProductController.php
@@ -20,11 +20,13 @@ public function index(Request $request)
 
         $products = Product::with('category')
             ->when($search, function ($query) use ($search) {
-                $query->where(function ($subQuery) use ($search) {
-                    $subQuery->where('name', 'like', "%{$search}%")
-                        ->orWhere('description', 'like', "%{$search}%")
-                        ->orWhereHas('category', function ($categoryQuery) use ($search) {
-                            $categoryQuery->where('name', 'like', "%{$search}%");
+                // BUG-004: búsqueda sin distinguir mayúsculas/minúsculas (LIKE en PostgreSQL sí distingue)
+                $term = '%' . mb_strtolower($search) . '%';
+                $query->where(function ($subQuery) use ($term) {
+                    $subQuery->whereRaw('LOWER(name) LIKE ?', [$term])
+                        ->orWhereRaw('LOWER(description) LIKE ?', [$term])
+                        ->orWhereHas('category', function ($categoryQuery) use ($term) {
+                            $categoryQuery->whereRaw('LOWER(name) LIKE ?', [$term]);
                         });
                 });
             })
