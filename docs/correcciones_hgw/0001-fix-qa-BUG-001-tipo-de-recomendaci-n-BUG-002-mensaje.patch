--- /dev/null
+++ b/database/migrations/2026_11_12_000001_alter_recommendation_type_to_string.php
@@ -0,0 +1,30 @@
+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+/**
+ * BUG-001 (QA Hito 4): RecommendationService guarda tipos como 'general' o 'health_based',
+ * pero la columna era un enum (muy_recomendado, recomendado, neutro, no_recomendado).
+ * En PostgreSQL el CHECK rechazaba el INSERT y el portal del cliente respondía 500.
+ */
+return new class extends Migration
+{
+    public function up(): void
+    {
+        if (DB::getDriverName() === 'pgsql') {
+            DB::statement('ALTER TABLE recommendations DROP CONSTRAINT IF EXISTS recommendations_recommendation_type_check');
+            DB::statement('ALTER TABLE recommendations ALTER COLUMN recommendation_type TYPE VARCHAR(30)');
+        } else {
+            Schema::table('recommendations', function ($table) {
+                $table->string('recommendation_type', 30)->change();
+            });
+        }
+    }
+
+    public function down(): void
+    {
+        // Sin reversión: volver al enum rompería los registros generados por el servicio.
+    }
+};
diff --git a/lang/es/auth.php b/lang/es/auth.php
new file mode 100755
index 0000000..8274f52
--- /dev/null
+++ b/lang/es/auth.php
@@ -0,0 +1,8 @@
