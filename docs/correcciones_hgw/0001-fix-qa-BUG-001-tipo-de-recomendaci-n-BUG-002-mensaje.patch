+
+// BUG-002: mensajes de autenticación en español (antes se mostraban los textos por defecto en inglés)
+return [
+    'failed' => 'El correo o la contraseña no son correctos.',
+    'password' => 'La contraseña ingresada no es correcta.',
+    'throttle' => 'Demasiados intentos de inicio de sesión. Intenta de nuevo en :seconds segundos.',
+];
